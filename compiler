make -s || { echo "Build failed"; exit 1; }
LEXER_TOKEN_TRACE=1 ./parser_unoptimized "$1" 2>tokens.txt
./parser_optimized "$1"
python3 tac_to_risc.py --run

# check if tac is generated and Run transpiler  
if python3 transpiler.py; then
    echo "Running generated.py"
    python3 generated.py
    pkill -f "http.server" 2>/dev/null || true
    echo "Server: http://localhost:8080"
    python3 -m http.server 8080 >/dev/null 2>&1 &
fi